    "direct_queries": {
      "\n        INSERT INTO llm_records\n            (agent_id, task_id, session_id, input_summary, input_text, metadata, status, run_kind, parent_record_id)\n        VALUES ($1, $2, $3, $4, $5, $6::jsonb, 'running', $7, $8)\n        RETURNING id\n        ": 1,
      "\n        SELECT count(*) AS task_count,\n               count(*) FILTER (WHERE parent_record_id=$2) AS parent_count,\n               COALESCE(sum(GREATEST(budget_usd-spent_usd, 0)) FILTER\n                   (WHERE finished_at IS NULL), 0) AS task_reserved,\n               COALESCE(sum(CASE WHEN finished_at IS NULL THEN GREATEST(budget_usd, spent_usd)\n                                ELSE spent_usd END), 0) AS task_committed,\n               COALESCE(sum(CASE WHEN finished_at IS NULL THEN GREATEST(budget_usd, spent_usd)\n                                ELSE spent_usd END) FILTER (WHERE parent_record_id=$2), 0) AS parent_committed\n          FROM agent_spawns WHERE task_id=$1 AND kind='explorer'\n        ": 3,
      "\n        UPDATE llm_records SET\n            status = $2,\n            output_text = $3,\n            output_summary = $4,\n            session_id = COALESCE($5, session_id),\n            input_tokens = $6,\n            output_tokens = $7,\n            cost_usd = $8,\n            duration_ms = $9,\n            model = COALESCE($10, model),\n            error = $11,\n            cache_read_tokens = $12,\n            cache_creation_tokens = $13,\n            context_tokens = $14,\n            compactions = $15::jsonb,\n            cost_source = $16,\n            metadata = CASE WHEN $17::text IS NULL AND $18::jsonb IS NULL THEN metadata\n                            ELSE COALESCE(metadata, '{}'::jsonb)\n                                 || CASE WHEN $17::text IS NULL THEN '{}'::jsonb\n                                         ELSE jsonb_build_object('outcome', $17::text) END\n                                 || COALESCE($18::jsonb, '{}'::jsonb) END,\n            finished_at = now(),\n            last_output_at = COALESCE(last_output_at, now()),\n            failure_class = $19,\n            failure_cause = $20\n        WHERE id = $1\n        ": 1,
      "SELECT * FROM agent_spawns WHERE id = $1": 5,
      "SELECT * FROM agent_spawns WHERE parent_record_id=$1 AND idempotency_key=$2": 3,
      "SELECT * FROM agent_spawns WHERE task_id = $1 ORDER BY id": 16,
      "SELECT * FROM llm_records WHERE id = $1": 5,
      "SELECT * FROM projects WHERE id = $1": 4,
      "SELECT * FROM role_configs WHERE role = $1": 3,
      "SELECT * FROM task_steps WHERE id = $1": 1,
      "SELECT * FROM tasks WHERE id = $1": 4,
      "SELECT count(*) FROM agent_spawns WHERE task_id=$1 AND kind='explorer' AND state IN ('asking','cancelling')": 3,
      "SELECT id, project_id, title, summary, source_kind, filename, path, size_bytes, sha256, created_at, updated_at FROM project_documents WHERE project_id = $1 ORDER BY created_at, id": 1,
      "SELECT json_build_object('id', a.id, 'name', a.name, 'model_id', a.model_id, 'effort', a.effort, 'builtin', a.builtin, 'agent_teams', a.agent_teams, 'web_search', a.web_search, 'custom_prompt', a.custom_prompt, 'fallback_profile_id', a.fallback_profile_id, 'runtime_id', r.id, 'runtime_name', r.name, 'runtime_type', r.type, 'runtime_executable', r.executable, 'runtime_launcher', r.launcher, 'runtime_version', r.version, 'runtime_capabilities', r.capabilities, 'provider_id', p.id, 'provider_name', p.name, 'provider', json_build_object('id', p.id, 'name', p.name, 'vendor_type', p.vendor_type, 'auth', p.auth, 'oauth_runtime_type', p.oauth_runtime_type, 'env', p.env, 'max_concurrency', p.max_concurrency, 'builtin', p.builtin, 'enabled', p.enabled), 'model', to_jsonb(m), 'endpoint', to_jsonb(e)) AS profile FROM agent_profiles a JOIN agent_runtimes r ON r.id = a.runtime_id JOIN llm_models m ON m.id = a.model_id JOIN llm_providers p ON p.id = m.provider_id JOIN llm_provider_endpoints e ON e.provider_id = m.provider_id AND e.protocol = m.protocol WHERE $1::text IS NULL OR p.id = $1 ORDER BY a.builtin DESC, a.name, a.id": 2,
      "SELECT json_build_object('id', a.id, 'name', a.name, 'model_id', a.model_id, 'effort', a.effort, 'builtin', a.builtin, 'agent_teams', a.agent_teams, 'web_search', a.web_search, 'custom_prompt', a.custom_prompt, 'fallback_profile_id', a.fallback_profile_id, 'runtime_id', r.id, 'runtime_name', r.name, 'runtime_type', r.type, 'runtime_executable', r.executable, 'runtime_launcher', r.launcher, 'runtime_version', r.version, 'runtime_capabilities', r.capabilities, 'provider_id', p.id, 'provider_name', p.name, 'provider', json_build_object('id', p.id, 'name', p.name, 'vendor_type', p.vendor_type, 'auth', p.auth, 'oauth_runtime_type', p.oauth_runtime_type, 'env', p.env, 'max_concurrency', p.max_concurrency, 'builtin', p.builtin, 'enabled', p.enabled), 'model', to_jsonb(m), 'endpoint', to_jsonb(e)) AS profile FROM project_allowed_profiles l JOIN agent_profiles a JOIN agent_runtimes r ON r.id = a.runtime_id JOIN llm_models m ON m.id = a.model_id JOIN llm_providers p ON p.id = m.provider_id JOIN llm_provider_endpoints e ON e.provider_id = m.provider_id AND e.protocol = m.protocol ON a.id = l.profile_id WHERE l.project_id = $1 ORDER BY a.name": 2,
      "SELECT max_concurrency FROM task_concurrency_limits WHERE task_id=$1 AND role='subagent'": 3,
      "SELECT p.* FROM projects p JOIN tasks t ON t.project_id=p.id WHERE t.id=$1": 3,
      "SELECT p.subagents FROM projects p JOIN tasks t ON t.project_id=p.id WHERE t.id=$1": 7,
      "SELECT state FROM agent_spawns WHERE parent_record_id=$1 AND kind='explorer' AND finished_at IS NOT NULL ORDER BY id DESC LIMIT 3": 3,
      "SELECT task_id FROM agent_spawns WHERE id=$1": 3,
      "UPDATE agent_spawns SET delivered_at=now(), delivery='tool', updated_at=now() WHERE id=ANY($1::bigint[]) AND kind='explorer' AND finished_at IS NOT NULL AND delivered_at IS NULL": 6,
      "UPDATE agent_spawns s SET delivery=CASE WHEN COALESCE(p.agent_room,'on')='on' THEN 'room' ELSE 'turn' END FROM tasks t,projects p WHERE s.id=$1 AND s.task_id=t.id AND t.project_id=p.id AND p.subagents='on' AND (COALESCE(p.agent_room,'on')='on' OR s.spawner='planner') AND s.delivered_at IS NULL": 6
    },
