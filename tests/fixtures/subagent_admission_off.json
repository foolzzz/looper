      "--print",
      "--verbose",
      "--output-format",
      "stream-json",
      "--include-partial-messages",
      "--input-format",
      "stream-json",
      "--replay-user-messages",
      "--setting-sources",
      "",
      "--strict-mcp-config",
      "--settings",
      "{\"autoMemoryEnabled\":false,\"claudeMdExcludes\":[\"/CLAUDE.md\",\"/.claude/CLAUDE.md\",\"/.claude/rules/**\",\"/AGENTS.md\",\"/.claude/AGENTS.md\",\"/home/operator/.claude/CLAUDE.md\",\"/home/operator/.claude/rules/**\",\"/home/operator/.claude/AGENTS.md\"],\"crossSessionInbound\":\"refuse\",\"disableAllHooks\":true}",
      "--append-system-prompt-file",
      "/runtime/prompt.md",
      "--system-prompt-snapshot",
      "off",
      "--permission-mode",
      "manual",
      "--permission-prompts",
      "none",
      "--tools",
      "Read,Glob,Grep",
      "--allowedTools",
      "Read,Glob,Grep",
      "--disallowedTools",
      "Bash,Edit,Write,NotebookEdit",
      "--disable-slash-commands",
      "--disallowedTools",
      "ListAgents,SendMessage",
      "--model",
      "opus",
      "--max-budget-usd",
      "0.5",
      "--max-turns",
      "40"
    ],
    "cancel_queued": {
      "result": {
        "spawn": {
          "budget_usd": 0.47,
          "cancel_reason": "requested",
          "delivery": "tool",
          "id": 2,
          "profile": "agent-claude-code-opus",
          "state": "cancelled"
        }
      },
      "status": "ok"
