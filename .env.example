# Looper Agent System — environment configuration
# Copy to .env and fill in your values. Never commit .env itself.
# (Before the rename these were LOOPX_*; the old names are read for one release.)

# PostgreSQL connection string (required for agent mode). The database keeps
# its name from before the rename, loopx.
LOOPER_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/loopx

# The bind address is a flag, not a variable: looper serve --host 127.0.0.1 --port 8767
