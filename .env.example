# LoopX Agent System — environment configuration
# Copy to .env and fill in your values. Never commit .env itself.

# PostgreSQL connection string (required for agent mode)
LOOPX_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/loopx

# Server bind address (optional, defaults shown)
# LOOPX_HOST=127.0.0.1
# LOOPX_PORT=8767
