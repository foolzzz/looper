    "PromptParams": {"type":"object","properties":{"session_id":{"type":"string","minLength":1},"trace_id":{"type":"string","minLength":1},"text":{"type":"string"},"tools":{"type":"array","items":{"$ref":"#/$defs/PlatformTool"}}},"required":["session_id","text","tools","trace_id"]},
    "SteerParams": {"type":"object","properties":{"session_id":{"type":"string","minLength":1},"trace_id":{"type":"string","minLength":1},"message_id":{"type":"string","minLength":1},"text":{"type":"string"},"if_idle":{"enum":["reject"]}},"required":["if_idle","message_id","session_id","text","trace_id"]},
