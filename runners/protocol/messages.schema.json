    "AuthorizeParams": {"type":"object","properties":{"session_id":{"type":"string","minLength":1},"trace_id":{"type":"string","minLength":1},"request_id":{"type":"string","minLength":1},"kind":{"enum":["turn","retry","compaction","subagent","tool","title","other"]},"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"estimated_input_tokens":{"type":"integer","minimum":0},"max_output_tokens":{"type":"integer","minimum":0}},"required":["estimated_input_tokens","kind","max_output_tokens","model","provider","request_id","session_id","trace_id"]},
    "InitializeResult": {"type":"object","properties":{"protocol_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+$"},"runner":{"$ref":"#/$defs/RunnerIdentity"},"sdk":{"$ref":"#/$defs/SdkIdentity"},"capabilities":{"$ref":"#/$defs/Capabilities"}},"required":["protocol_version","runner","sdk"]},
    "RunnerIdentity": {"type":"object","properties":{"kind":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}},"required":["kind","version"]},
    "SdkIdentity": {"type":"object","properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}},"required":["name","version"]},
    "Capabilities": {"type":"object","properties":{"per_session_isolation":{"type":"boolean"},"per_session_credentials":{"type":"boolean"},"max_sessions":{"type":"integer","minimum":0},"cancel":{"type":"boolean"},"steer":{"$ref":"#/$defs/SteerCapability"},"usage":{"$ref":"#/$defs/UsageCapability"},"authorize_covers":{"type":"array","items":{"enum":["turn","retry","compaction","subagent","tool","title","other"]}},"fork":{"type":"boolean"}}},
