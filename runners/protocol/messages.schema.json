  "$comment": "UTF-8 JSON object + LF, <=4194304 bytes excluding LF. Unknown fields ignored. Connection owners enforce initialize once before sessions, id/trace correlation and settled last. Unknown methods return METHOD_NOT_FOUND. Capabilities absent = false; no SDK version gates.",
  "type": "object",
  "properties": {"jsonrpc":{"const":"2.0"}},
  "required": ["jsonrpc"],
  "oneOf": [
    {"properties":{"method":{"type":"string","minLength":1},"params":{"type":"object"},"id":{"type":"string","pattern":"^[lr]-[0-9]+$"}},"required":["method","params"],"not":{"anyOf":[{"required":["result"]},{"required":["error"]}]},"allOf":[{"if":{"properties":{"method":{"const":"runner/health"}}},"then":{"properties":{"params":{"$ref":"#/$defs/Empty"},"id":{"type":"string","pattern":"^l-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"initialize"}}},"then":{"properties":{"params":{"$ref":"#/$defs/InitializeParams"},"id":{"type":"string","pattern":"^l-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"session/new"}}},"then":{"properties":{"params":{"$ref":"#/$defs/NewSessionParams"},"id":{"type":"string","pattern":"^l-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"session/load"}}},"then":{"properties":{"params":{"$ref":"#/$defs/LoadSessionParams"},"id":{"type":"string","pattern":"^l-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"session/prompt"}}},"then":{"properties":{"params":{"$ref":"#/$defs/PromptParams"},"id":{"type":"string","pattern":"^l-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"session/steer"}}},"then":{"properties":{"params":{"$ref":"#/$defs/SteerParams"},"id":{"type":"string","pattern":"^l-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"session/cancel"}}},"then":{"properties":{"params":{"$ref":"#/$defs/Turn"},"id":{"type":"string","pattern":"^l-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"session/close"}}},"then":{"properties":{"params":{"$ref":"#/$defs/CloseParams"},"id":{"type":"string","pattern":"^l-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"session/update"}}},"then":{"properties":{"params":{"anyOf":[{"$ref":"#/$defs/TextDelta"},{"$ref":"#/$defs/MessageUpdate"},{"$ref":"#/$defs/ToolResultUpdate"},{"$ref":"#/$defs/RequestEnd"},{"$ref":"#/$defs/SteerApplied"},{"$ref":"#/$defs/SteerDropped"},{"$ref":"#/$defs/Settled"}]}},"not":{"required":["id"]}}},{"if":{"properties":{"method":{"const":"tools/call"}}},"then":{"properties":{"params":{"$ref":"#/$defs/ToolCallParams"},"id":{"type":"string","pattern":"^r-[0-9]+$"}},"required":["id"]}},{"if":{"properties":{"method":{"const":"budget/authorize"}}},"then":{"properties":{"params":{"$ref":"#/$defs/AuthorizeParams"},"id":{"type":"string","pattern":"^r-[0-9]+$"}},"required":["id"]}}]},
    {"required":["id"],"not":{"anyOf":[{"required":["method"]},{"required":["params"]}]},"oneOf":[{"properties":{"id":{"type":"string","pattern":"^[lr]-[0-9]+$"},"result":{"type":"object"}},"required":["result"],"not":{"required":["error"]}},{"properties":{"id":{"anyOf":[{"type":"string","pattern":"^[lr]-[0-9]+$"},{"type":"null"}]},"error":{"$ref":"#/$defs/RpcError"}},"required":["error"],"not":{"required":["result"]}}]}
  ],
