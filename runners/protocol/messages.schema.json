    "ToolResultUpdate": {"type":"object","properties":{"session_id":{"type":"string","minLength":1},"trace_id":{"type":"string","minLength":1},"kind":{"enum":["tool_result"]},"call_id":{"type":"string","minLength":1},"text":{"type":"string"},"is_error":{"type":"boolean"}},"required":["call_id","is_error","kind","session_id","text","trace_id"]},
    "RequestEnd": {"type":"object","properties":{"session_id":{"type":"string","minLength":1},"trace_id":{"type":"string","minLength":1},"kind":{"enum":["request_end"]},"request_id":{"type":"string","minLength":1},"request_kind":{"enum":["turn","retry","compaction","subagent","tool","title","other"]},"model":{"type":"string","minLength":1},"status":{"type":"string","minLength":1},"input_uncached":{"type":"integer","minimum":0},"output":{"type":"integer","minimum":0},"cache_read":{"type":"integer","minimum":0},"cache_write":{"type":"integer","minimum":0},"reasoning":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}]},"complete":{"type":"boolean"}},"required":["cache_read","cache_write","complete","input_uncached","kind","model","output","reasoning","request_id","request_kind","session_id","status","trace_id"]},
    "SteerApplied": {"type":"object","properties":{"session_id":{"type":"string","minLength":1},"trace_id":{"type":"string","minLength":1},"kind":{"enum":["steer_applied"]},"message_id":{"type":"string","minLength":1},"after_request_id":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"after_tool_batch":{"type":"boolean"},"new_turn":{"enum":[false]}},"required":["after_request_id","after_tool_batch","kind","message_id","new_turn","session_id","trace_id"]},
    "SteerDropped": {"type":"object","properties":{"session_id":{"type":"string","minLength":1},"trace_id":{"type":"string","minLength":1},"kind":{"enum":["steer_dropped"]},"message_id":{"type":"string","minLength":1},"reason":{"enum":["cancelled","turn_ended","session_closed"]}},"required":["kind","message_id","reason","session_id","trace_id"]},
    "Settled": {"type":"object","properties":{"session_id":{"type":"string","minLength":1},"trace_id":{"type":"string","minLength":1},"kind":{"enum":["settled"]},"outcome":{"enum":["completed","cancelled","capped","max_requests","failed"]},"final_text":{"type":"string"},"requests":{"type":"integer","minimum":0},"usage_complete":{"type":"boolean"},"error":{"$ref":"#/$defs/TurnError"}},"required":["final_text","kind","outcome","requests","session_id","trace_id","usage_complete"]},
    "TurnError": {"type":"object","properties":{"kind":{"enum":["PARSE_ERROR","INVALID_REQUEST","METHOD_NOT_FOUND","INVALID_PARAMS","INTERNAL_ERROR","SESSION_NOT_FOUND","SESSION_OWNED","SESSION_BUSY","NOT_RUNNING","TRACE_MISMATCH","CAPACITY","UNSUPPORTED","ISOLATION_REFUSED","VERSION_MISMATCH","PROVIDER_AUTH","PROVIDER_UNAVAILABLE","CONTEXT_OVERFLOW","OUTPUT_TRUNCATED"]},"message":{"type":"string"}},"required":["kind","message"]},
