    "LoadSessionParams": {"type":"object","properties":{"session_key":{"type":"string","pattern":"^[A-Za-z0-9_-]+$"},"role":{"enum":["manager","planner","worker","reviewer"]},"cwd":{"type":"string","minLength":1},"add_dirs":{"type":"array","items":{"type":"string"}},"env":{"type":"object","additionalProperties":{"type":"string"}},"home":{"type":"string","minLength":1},"state_dir":{"type":"string","minLength":1},"provider":{"$ref":"#/$defs/Provider"},"system_prompt":{"$ref":"#/$defs/SystemPrompt"},"tools":{"$ref":"#/$defs/Tools"},"limits":{"$ref":"#/$defs/Limits"},"session_id":{"type":"string","minLength":1}},"required":["add_dirs","cwd","env","home","limits","provider","role","session_id","session_key","state_dir","system_prompt","tools"]},
